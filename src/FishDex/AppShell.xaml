<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FishDex.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FishDex"
    Title="FishDex"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
    Shell.NavBarHasShadow="True"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
    >
    <ShellContent
        Title="FishDex"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"/>
</Shell>
